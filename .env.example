# Copy to .env and fill in. Nothing here is needed to run the MCP server itself —
# the server, the DB, retrieval and embeddings are all free and offline.

# --- Cloud providers (only needed for --provider openai / deepseek) ---
# All three providers speak the OpenAI wire format, so they differ by base_url,
# key and model name only. See the PROVIDERS table in agent/providers.py.
OPENAI_API_KEY=sk-...
# Set explicitly rather than hardcoding a model id in source.
OPENAI_MODEL=gpt-4o-mini

DEEPSEEK_API_KEY=sk-...
DEEPSEEK_MODEL=deepseek-chat

# --- Local provider (default; free, offline) ---
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.2:latest
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- HTTP transport (only needed for `uvicorn server.http_app:app`) ---
# Stdio needs none of this. Over HTTP the server is a real OAuth resource
# server: every request needs a bearer token, and the token's scopes decide
# which tools the caller may reach.
#
# Demo tokens, format `token:subject:scope|scope,...`. Unset means the two
# defaults in server/http_app.py. Replace StaticTokenVerifier with a JWT/
# introspection verifier for anything real — TokenVerifier is a one-method
# Protocol precisely so that swap touches nothing else.
# MCP_TOKENS=writer-token:analyst@bank.example:dispute:read|dispute:propose
MCP_TOKEN=writer-token
MCP_ISSUER_URL=http://localhost:8000
MCP_RESOURCE_URL=http://localhost:8000

# Per-session grounding state (server/session_state.py). The SDK evicts its own
# transports on idle; it does not know about ours, so this map is bounded here.
MCP_SESSION_TTL=3600
MCP_MAX_SESSIONS=1000

# Scopes to assume when there is NO bearer token, i.e. stdio. Unset means
# unrestricted, which is correct for a subprocess owned by its caller. Set it to
# exercise scope denial through the same code path HTTP uses.
# MCP_STDIO_SCOPES=dispute:read

# --- Langfuse tracing (optional, for the LangGraph agent in agent/graph.py) ---
# Sign up at langfuse.com (free 50k observations/mo), create a project, copy keys.
# No vendor lock-in — OpenTelemetry-based, works with any framework.
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- Retrieval ---
# keyword   = stdlib TF-IDF, zero deps. THE DEFAULT: zero dependencies and wins
#             the depth (recall@8) that a two-stage pipeline feeds on.
# embedding = nomic-embed-text via Ollama (768-dim) + numpy cosine
RETRIEVER=keyword

# Cross-encoder reranking (PyTorch). Lifts TF-IDF recall@1 from 37% to 50% on
# 30 cases, but costs a torch dependency. Off by default.
RERANK=0
